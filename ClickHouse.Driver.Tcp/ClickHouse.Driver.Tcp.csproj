<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- SA0001: StyleCop cannot check doc comments without a generated XML doc file, and no project in this
         repository generates one. Every public member here is documented; build with
         -p:GenerateDocumentationFile=true to check that. -->
    <NoWarn>$(NoWarn);SA0001</NoWarn>
    <!-- Not published on its own; its assembly is packed into the ClickHouse.Driver package. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The analyzer only reads files it is handed; it does not glob for them. Both files are required:
         given only one, it reports RS0048 and stops checking the surface altogether. Shipped is empty until
         the first release, when the Unshipped entries move into it. Exactly one pair, too - a second pair
         also silently disables RS0016. -->
    <AdditionalFiles Include="PublicAPI/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI/PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The IServiceCollection extensions under DependencyInjection/ need the abstractions only.
         ClickHouse.Driver declares the same package so the NuGet package states it: this project is packed
         into that one as a DLL, and a PrivateAssets="all" reference carries no dependency across. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    <PackageReference Include="StyleCop.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The compression frame's codecs (LZ4/ZSTD) and CityHash live here, shared with the HTTP driver.
         PrivateAssets matches how ClickHouse.Driver references it: one copy is packed, not two. -->
    <ProjectReference Include="..\ClickHouse.Driver.Common\ClickHouse.Driver.Common.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>
