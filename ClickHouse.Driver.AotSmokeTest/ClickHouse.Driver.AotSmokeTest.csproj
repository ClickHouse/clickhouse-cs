<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the HTTP client as a native AOT app against a real server. Publish it, then run the binary:

      dotnet publish ClickHouse.Driver.AotSmokeTest -c Release -r linux-x64 -o artifacts/aot
      CLICKHOUSE_CONNECTION="Host=localhost;Password=..." artifacts/aot/ClickHouse.Driver.AotSmokeTest

    It exits non-zero if a check fails. Trim and AOT warnings fail the publish, so a change that makes the driver
    unsafe to trim fails here even before a check runs. `dotnet run` runs the same checks with the JIT.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PublishAot>true</PublishAot>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- One warning per call site rather than one per assembly, so a failure names the code to fix. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClickHouse.Driver\ClickHouse.Driver.csproj" />
  </ItemGroup>

</Project>
