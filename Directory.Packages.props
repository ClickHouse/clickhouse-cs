<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ClickHouseDriverVersion Condition="'$(ClickHouseDriverVersion)' == ''">1.3.0</ClickHouseDriverVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="ClickHouse.Driver" Version="$(ClickHouseDriverVersion)" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="coverlet.msbuild" Version="10.1.1" />
    <PackageVersion Include="Dapper" Version="2.1.100" />
    <PackageVersion Include="Dapper.Contrib" Version="2.0.78" />
    <PackageVersion Include="Fody" Version="6.9.3" />
    <PackageVersion Include="GitHubActionsTestLogger" Version="3.0.5" />
    <PackageVersion Include="InlineMethod.Fody" Version="0.8.7" />
    <PackageVersion Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageVersion Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageVersion Include="linq2db" Version="6.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.15" />
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="NodaTime" Version="3.3.7" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit.Console" Version="3.22.0" />
    <PackageVersion Include="NUnit.ConsoleRunner" Version="3.22.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageVersion Include="Polly" Version="8.9.1" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="System.Text.Json" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.ClickHouse" Version="4.17.0" />
    <PackageVersion Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
