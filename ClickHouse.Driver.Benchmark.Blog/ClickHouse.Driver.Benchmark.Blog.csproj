<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Annotations only: this is new code, so the annotations are meaningful, but full flow
         analysis would fight the driver's own partially-annotated surface for no benefit here. -->
    <Nullable>annotations</Nullable>
    <AssemblyName>ClickHouse.Driver.Benchmark.Blog</AssemblyName>
    <RootNamespace>ClickHouse.Driver.Benchmark.Blog</RootNamespace>
    <!-- Long macro benchmarks: never packed, never shipped. -->
    <IsPackable>false</IsPackable>
    <!-- Server GC is selected per BDN job, not per process; see LongRunConfig. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Reads the .nettrace files EventPipeProfiler writes; see GcTraceReport. Already present
         transitively via BenchmarkDotNet at the same version, so this pins rather than adds. -->
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>

  <!--
    ============================================================================
    Two reference modes, exactly as ClickHouse.Driver.Benchmark does it.

      * Source mode (default)     — ProjectReference to the working tree. This is the "new" arm.
      * Comparison mode           — PackageReference to a published ClickHouse.Driver, selected by
                                    /p:ClickHouseDriverVersion. LongRunConfig turns BASELINE_VERSION
                                    and PR_VERSION into two such builds.

    Comparison mode compiles ONE source tree against BOTH packages, so a harness that must span
    v1.0.0 can only touch v1.0.0 API. The define constants below are how each harness opts into
    the API level it needs; see docs/API-CORRIDOR.md for the verified surface per version.
    ============================================================================
  -->
  <PropertyGroup Condition="'$(BenchmarkComparisonMode)' != 'true'">
    <ClickHouseDriverApiLevel Condition="'$(ClickHouseDriverApiLevel)' == ''">latest</ClickHouseDriverApiLevel>
  </PropertyGroup>
  <ItemGroup Condition="'$(BenchmarkComparisonMode)' != 'true'">
    <ProjectReference Include="..\ClickHouse.Driver\ClickHouse.Driver.csproj" />
    <!-- Compression types live in the bundled (PrivateAssets="all") Common assembly. In comparison
         mode they come from Common.dll inside the package instead. -->
    <ProjectReference Include="..\ClickHouse.Driver.Common\ClickHouse.Driver.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(BenchmarkComparisonMode)' == 'true'">
    <PackageReference Include="ClickHouse.Driver" />
  </ItemGroup>

  <!--
    The API level defaults to the referenced package version, but 0.0.0-style CI versions
    (/benchmark-compare builds the PR package as 0.0.0-pr.N) compare BELOW every real release and
    would silently compile the modern API out of the arm that is supposed to have it. Treat a 0.x
    version as "whatever the source tree has", which is what such a package actually is.
  -->
  <PropertyGroup Condition="'$(BenchmarkComparisonMode)' == 'true' AND '$(ClickHouseDriverApiLevel)' == ''">
    <ClickHouseDriverApiLevel Condition="$([MSBuild]::VersionLessThan('$(ClickHouseDriverVersion)', '1.0.0'))">latest</ClickHouseDriverApiLevel>
    <ClickHouseDriverApiLevel Condition="'$(ClickHouseDriverApiLevel)' == ''">$(ClickHouseDriverVersion)</ClickHouseDriverApiLevel>
  </PropertyGroup>

  <!--
    ============================================================================
    API corridor gates. Each constant means "the referenced driver exposes this".
    A harness guards the arms that need it; nothing else has to know about versions.
    ============================================================================
  -->
  <PropertyGroup>
    <_ApiIsLatest>false</_ApiIsLatest>
    <_ApiIsLatest Condition="'$(ClickHouseDriverApiLevel)' == 'latest'">true</_ApiIsLatest>

    <!-- v1.2.0: RegisterBinaryInsertType<T> / InsertBinaryAsync<T> (POCO binary insert). -->
    <_Api12>$(_ApiIsLatest)</_Api12>
    <_Api12 Condition="'$(_ApiIsLatest)' != 'true'">$([MSBuild]::VersionGreaterThanOrEquals('$(ClickHouseDriverApiLevel)', '1.2.0'))</_Api12>

    <!-- v1.3.0: ReadBufferSize, RegisterPocoType<T>, QueryAsync<T>, ReadValueConverter, AcceptEncoding. -->
    <_Api13>$(_ApiIsLatest)</_Api13>
    <_Api13 Condition="'$(_ApiIsLatest)' != 'true'">$([MSBuild]::VersionGreaterThanOrEquals('$(ClickHouseDriverApiLevel)', '1.3.0'))</_Api13>

    <!-- v1.4.0, unreleased: pluggable insert compression (#427), the built-in lz4 (#431) and zstd
         (#523/#526) codecs, and response-codec selection via ClickHouseClientSettings.AcceptEncoding
         (#490/#526). AcceptEncoding is NOT in 1.3.0 despite what the benchmark plan's corridor table
         says — verified against the 1.3.0 tag, which has no such property.

         Gated on the version rather than on "source mode only": a source-only gate compiles all of
         this out of a locally packed 1.4.0-local, the one arm meant to have every codec, and that arm
         then still builds and still reports numbers. -->
    <_Api14>$(_ApiIsLatest)</_Api14>
    <_Api14 Condition="'$(_ApiIsLatest)' != 'true'">$([MSBuild]::VersionGreaterThanOrEquals('$(ClickHouseDriverApiLevel)', '1.4.0'))</_Api14>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants Condition="'$(_Api12)' == 'true'">$(DefineConstants);CH_API_1_2</DefineConstants>
    <DefineConstants Condition="'$(_Api13)' == 'true'">$(DefineConstants);CH_API_1_3</DefineConstants>
    <DefineConstants Condition="'$(_Api14)' == 'true'">$(DefineConstants);CH_API_1_4</DefineConstants>
  </PropertyGroup>

  <!-- Surface the resolved corridor in the build log: a silently-wrong API level would otherwise
       look like a harness that simply has fewer arms. -->
  <Target Name="ReportApiCorridor" BeforeTargets="CoreCompile">
    <Message Importance="high"
             Text="[blog-bench] driver=$(ClickHouseDriverVersion) apiLevel=$(ClickHouseDriverApiLevel) 1.2=$(_Api12) 1.3=$(_Api13) 1.4=$(_Api14)" />
  </Target>

</Project>
